# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string (Supabase or standalone Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# =============================================================================
# SUPABASE
# =============================================================================

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key (safe to use server-side)
SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# AUTHENTICATION
# =============================================================================

# HS256 secret for signing/verifying JWT tokens (1-day TTL)
JWT_SECRET=change-me-to-a-strong-random-secret

# Google OAuth credentials — create at console.cloud.google.com
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# APP CONFIGURATION (public — exposed to the browser)
# =============================================================================

# Canonical base URL; used for OAuth redirect URIs and invite share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UI language: "es" (formal Spanish) | "es-coloquial" (Rioplatense)
NEXT_PUBLIC_APP_LANG=es

# Set to "false" to disable the public /register endpoint and Google sign-up
NEXT_PUBLIC_ENABLE_REGISTRATION=true

# Set to "false" to hide group creation UI and block the POST /api/groups route
NEXT_PUBLIC_ENABLE_GROUP_CREATION=true

# Default password assigned to newly created player accounts
NEXT_PUBLIC_INITIAL_USER_PASSWORD=truco1234
